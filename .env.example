# Shared admin key gating the staff-facing app (Typeform self-serve path stays open, no key)
ADMIN_SECRET=

# Supabase (Postgres + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Attio (guardian reconciliation + notification email lookup)
ATTIO_API_KEY=
ATTIO_GUARDIANS_LIST=all_guardians

# OpenAI (cyberpunk stylization via gpt-image-1.5 /v1/images/edits)
OPENAI_API_KEY=

# Typeform (self-serve guardian intake webhook)
TYPEFORM_WEBHOOK_SECRET=
# Personal access token, only needed if file_url downloads require auth
TYPEFORM_API_TOKEN=

# Harmonic.ai (photo lookup for guardians not yet in our database)
HARMONIC_API_KEY=

# Gmail (missing-photo reminder emails)
GMAIL_SENDER_ADDRESS=
